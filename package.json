{
  "name": "oh-my-openagent-vscode",
  "displayName": "Oh My OpenAgent",
  "description": "Manage and override Oh My OpenAgent models, agents, and categories from VS Code.",
  "version": "1.2.0-beta.2",
  "private": true,
  "license": "MIT",
  "publisher": "andersou",
  "repository": {
    "type": "git",
    "url": "https://github.com/andersou/oh-my-openagent-vscode-extension.git"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ohMyOpenAgentPanel",
          "title": "Oh My OpenAgent",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "ohMyOpenAgentPanel": [
        {
          "id": "ohMyOpenAgent.models",
          "name": "Models",
          "contextualTitle": "Oh My OpenAgent Models"
        }
      ]
    },
    "commands": [
      {
        "command": "ohMyOpenAgent.openAgentManager",
        "title": "Open Agent Manager",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.editAgent",
        "title": "Edit Agent",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.editCategory",
        "title": "Edit Category",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.refresh",
        "title": "Refresh",
        "category": "Oh My OpenAgent",
        "icon": "$(refresh)"
      },
      {
        "command": "ohMyOpenAgent.selectConfigScope",
        "title": "Select Config Scope",
        "category": "Oh My OpenAgent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ohMyOpenAgent.selectRoutingDialect",
        "title": "Select Disk Routing Dialect",
        "category": "Oh My OpenAgent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ohMyOpenAgent.createProfile",
        "title": "Create Profile",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.createProfileFromConfig",
        "title": "Create Profile from Config File…",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.activateProfile",
        "title": "Activate Profile",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.renameProfile",
        "title": "Rename Profile",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.duplicateProfile",
        "title": "Duplicate Profile",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.deleteProfile",
        "title": "Delete Profile",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.saveActiveProfile",
        "title": "Save Active Profile",
        "category": "Oh My OpenAgent",
        "icon": "$(save)"
      },
      {
        "command": "ohMyOpenAgent.importProfiles",
        "title": "Import Profile(s)",
        "category": "Oh My OpenAgent",
        "icon": "$(insert)"
      },
      {
        "command": "ohMyOpenAgent.exportAllProfiles",
        "title": "Export All Profiles",
        "category": "Oh My OpenAgent",
        "icon": "$(export)"
      },
      {
        "command": "ohMyOpenAgent.exportProfile",
        "title": "Export Profile",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.editProfileJson",
        "title": "Edit Profile JSON",
        "category": "Oh My OpenAgent"
      },
      {
        "command": "ohMyOpenAgent.editActiveProfileJson",
        "title": "Edit Active Profile JSON",
        "category": "Oh My OpenAgent"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "ohMyOpenAgent.editAgent",
          "when": "view == ohMyOpenAgent.models && (viewItem == agent || viewItem == agentOverride)",
          "group": "inline"
        },
        {
          "command": "ohMyOpenAgent.editCategory",
          "when": "view == ohMyOpenAgent.models && (viewItem == category || viewItem == categoryOverride)",
          "group": "inline"
        },
        {
          "command": "ohMyOpenAgent.activateProfile",
          "when": "view == ohMyOpenAgent.models && viewItem == profile",
          "group": "profile"
        },
        {
          "command": "ohMyOpenAgent.renameProfile",
          "when": "view == ohMyOpenAgent.models && viewItem == profile",
          "group": "profile"
        },
        {
          "command": "ohMyOpenAgent.duplicateProfile",
          "when": "view == ohMyOpenAgent.models && viewItem == profile",
          "group": "profile"
        },
        {
          "command": "ohMyOpenAgent.exportProfile",
          "when": "view == ohMyOpenAgent.models && viewItem == profile",
          "group": "profile"
        },
        {
          "command": "ohMyOpenAgent.editProfileJson",
          "when": "view == ohMyOpenAgent.models && viewItem == profile",
          "group": "profile"
        },
        {
          "command": "ohMyOpenAgent.deleteProfile",
          "when": "view == ohMyOpenAgent.models && viewItem == profile",
          "group": "profile"
        },
        {
          "command": "ohMyOpenAgent.saveActiveProfile",
          "when": "view == ohMyOpenAgent.models && viewItem == activeProfileModified",
          "group": "inline"
        },
        {
          "command": "ohMyOpenAgent.editActiveProfileJson",
          "when": "view == ohMyOpenAgent.models && viewItem == configFile",
          "group": "inline"
        },
        {
          "command": "ohMyOpenAgent.createProfileFromConfig",
          "when": "view == ohMyOpenAgent.models && viewItem == profilesGroup",
          "group": "profileOps@1"
        },
        {
          "command": "ohMyOpenAgent.importProfiles",
          "when": "view == ohMyOpenAgent.models && viewItem == profilesGroup",
          "group": "profileOps@2"
        },
        {
          "command": "ohMyOpenAgent.exportAllProfiles",
          "when": "view == ohMyOpenAgent.models && viewItem == profilesGroup",
          "group": "profileOps@3"
        }
      ],
      "commandPalette": [
        {
          "command": "ohMyOpenAgent.editAgent",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.editCategory",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.activateProfile",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.renameProfile",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.duplicateProfile",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.deleteProfile",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.saveActiveProfile",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.exportProfile",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.editProfileJson",
          "when": "false"
        },
        {
          "command": "ohMyOpenAgent.editActiveProfileJson",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ohMyOpenAgent.refresh",
          "when": "view == ohMyOpenAgent.models",
          "group": "navigation"
        },
        {
          "command": "ohMyOpenAgent.selectConfigScope",
          "when": "view == ohMyOpenAgent.models",
          "group": "navigation"
        },
        {
          "command": "ohMyOpenAgent.selectRoutingDialect",
          "when": "view == ohMyOpenAgent.models",
          "group": "navigation"
        },
        {
          "command": "ohMyOpenAgent.createProfile",
          "when": "view == ohMyOpenAgent.models",
          "group": "navigation"
        },
        {
          "command": "ohMyOpenAgent.importProfiles",
          "when": "view == ohMyOpenAgent.models",
          "group": "navigation"
        },
        {
          "command": "ohMyOpenAgent.exportAllProfiles",
          "when": "view == ohMyOpenAgent.models",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "dependencies": {
    "jsonc-parser": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "esbuild-svelte": "^0.9.5",
    "happy-dom": "^20.10.4",
    "svelte": "^5.56.3",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.4.5",
    "vitest": "4.1.10"
  }
}
